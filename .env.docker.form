# Форма заполнения для .env.docker (для запуска в Docker)
# Скопируйте этот файл как .env.docker в корень проекта и заполните значения
# Файл .env.docker добавлен в .gitignore — не коммитьте реальные пароли

# Django
DEBUG=1
SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
CORS_ALLOWED_ORIGINS=http://localhost http://127.0.0.1

# Database
DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=project-db
POSTGRES_USER=user-db
POSTGRES_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432

# Site
SITE_URL=http://localhost

# Email
EMAIL_HOST_USER=projectdysarthria@gmail.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_CONFIRMATION_TOKEN_LIFETIME=15

# Admin
ADMIN_EMAIL=vadas25@yandex.ru
ADMIN_PASSWORD=change-me

# Password reset
PASSWORD_RESET_TOKEN_LIFETIME=15

# MinIO пока не используется и не запускается.
# Сервис и переменные MINIO_* будут добавлены в следующих обновлениях.
