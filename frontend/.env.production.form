# Форма заполнения для frontend/.env.production (для production-сборки в Docker)
# Скопируйте этот файл как frontend/.env.production и заполните значения
#
# Пустое значение REACT_APP_BASE_URL= корректно для docker-развёртывания:
# axios шлёт запросы на тот же origin, nginx проксирует /api/ в Django.
# Не указывайте здесь http://127.0.0.1:8000 — в Docker это сломает API.

REACT_APP_BASE_URL=
