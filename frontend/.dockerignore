# Dependencies are installed inside the image (see frontend/Dockerfile).
# Never copy a local node_modules into the build context: it can contain
# broken/partial installs and symlinks that shadow the image's own install.
node_modules
build

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local env files (production env is committed separately)
.env.local
.env.development.local
.env.test.local
.env.production.local

# VCS / editor noise
.git
.gitignore
.DS_Store
